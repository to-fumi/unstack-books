{
  "name": "unstack-books",
  "private": true,
  "description": "husky / lint-staged 用（アプリ本体は Python）",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.py": [
      "uv run ruff check --fix",
      "uv run ruff format"
    ]
  }
}
